<Window x:Class="NonChromeBrowser.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup - Catkatz's Browser! :D" Height="430" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Privacy Setup" FontSize="20" FontWeight="Bold"/>
            <CheckBox x:Name="JsCheckbox" Content="Enable JavaScript" Margin="0,8,0,0"/>
            <CheckBox x:Name="ImagesCheckbox" Content="Show images" Margin="0,8,0,0"/>
            <CheckBox x:Name="CookiesCheckbox" Content="Clear cookies on exit" Margin="0,8,0,0"/>
            <CheckBox x:Name="TrackersCheckbox" Content="Block known trackers" Margin="0,8,0,0"/>
            <CheckBox x:Name="AdsCheckbox" Content="Block ads" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Home URL" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="HomeUrlBox" MinWidth="300"/>
            </StackPanel>
            <TextBlock Text="Theme" FontSize="16" FontWeight="Bold" Margin="0,14,0,4"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Preset" Width="80" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemePresetBox" MinWidth="180">
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="Black"/>
                    <ComboBoxItem Content="Green"/>
                    <ComboBoxItem Content="Blue"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Background" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="BackgroundColorBox" MinWidth="120"/>
                <TextBlock Text="Foreground" Width="80" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox x:Name="ForegroundColorBox" MinWidth="120"/>
                <TextBlock Text="Accent" Width="60" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox x:Name="AccentColorBox" MinWidth="120"/>
            </StackPanel>
            <TextBlock Text="Search" FontSize="16" FontWeight="Bold" Margin="0,14,0,4"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Engine" Width="80" VerticalAlignment="Center"/>
                <ComboBox x:Name="SearchEngineBox" MinWidth="180">
                    <ComboBoxItem Content="Google"/>
                    <ComboBoxItem Content="DuckDuckGo"/>
                    <ComboBoxItem Content="Bing"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="LiteModeCheckbox" Content="Lite mode (faster: block videos/iframes)" Margin="0,8,0,0"/>
            <CheckBox Name="SkipWizardCheckbox" Content="Do not show me AND ask me again" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Click="Cancel_Click"/>
            <Button Content="Save" Width="120" Margin="8,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>